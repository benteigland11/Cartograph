    "/v1/widgets/{owner_handle}/{widget_id}/download": {
      "get": {
        "summary": "Download a widget's zip bundle",
        "tags": [
          "Widgets"
        ],
        "operationId": "download_widget",
        "parameters": [
          {
            "name": "owner_handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "widget_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Widget zip. X-Widget-Version and X-Widget-Governance response headers carry metadata.",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "X-Widget-Version": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Widget-Governance": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Widget not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
