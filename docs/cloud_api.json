    "/v1/widgets/{widget_id}/publish": {
      "post": {
        "summary": "Publish a widget version",
        "tags": [
          "Widgets"
        ],
        "operationId": "push",
        "parameters": [
          {
            "name": "widget_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "widget_id": {
                    "type": "string"
                  },
                  "visibility": {
                    "type": "string"
                  },
                  "stamp": {
                    "type": "string"
                  },
                  "allowed_extensions": {
                    "type": "string"
                  },
                  "implementation_hash": {
                    "type": "string"
                  },
                  "governance": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "widget_id",
                  "stamp"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushResponse"
                }
              }
            }
          }
        }
      }
    },
